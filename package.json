{
  "name": "quiz-forge-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "QuizForge - AI-Powered MCQ Quiz Platform",
  "scripts": {
    "dev": "pnpm --parallel --filter @quiz-forge/backend --filter @quiz-forge/frontend dev",
    "dev:backend": "pnpm --filter @quiz-forge/backend dev",
    "dev:frontend": "pnpm --filter @quiz-forge/frontend dev",
    "build": "pnpm --filter @quiz-forge/shared build && pnpm --filter @quiz-forge/backend build && pnpm --filter @quiz-forge/frontend build",
    "test": "pnpm --recursive test",
    "typecheck": "pnpm --filter @quiz-forge/shared build && pnpm --recursive typecheck",
    "db:generate": "pnpm --filter @quiz-forge/backend db:generate",
    "db:migrate": "pnpm --filter @quiz-forge/backend db:migrate",
    "db:seed": "pnpm --filter @quiz-forge/backend exec tsx src/db/seed.ts"
  },
  "devDependencies": {
    "playwright": "^1.65.1",
    "typescript": "^5.7.3"
  }
}
