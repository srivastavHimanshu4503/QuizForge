# Server Configuration
PORT=4000
HOST=0.0.0.0
NODE_ENV=development

# Database Configuration (SQLite file path or connection string)
DATABASE_URL=quizforge.db

# Authentication (Minimum 32 characters for JWT signing)
JWT_SECRET=quizforge-super-secret-dev-jwt-key-replace-in-production-min-32-chars

# CORS (Frontend client origin)
CORS_ORIGIN=http://localhost:5173

# Google Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Groq API Configuration (Optional - for high-speed open-weights models)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# NVIDIA NIM API Configuration (Optional - for NVIDIA Hosted LLMs)
NVIDIA_API_KEY=nvapi-your_nvidia_api_key_here
NVIDIA_MODEL=meta/llama-3.3-70b-instruct

# GitHub Personal Access Token (Optional - increases rate limit from 60 to 5000 req/hr)
GITHUB_TOKEN=ghp_your_github_token_here
