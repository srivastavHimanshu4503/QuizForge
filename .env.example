# ==============================================================================
# QuizForge — Master Production Environment Configuration
# ==============================================================================

# Server & Network Configuration
PORT=4000
HOST=0.0.0.0
NODE_ENV=production

# Database Configuration (SQLite file path with WAL mode)
DATABASE_URL=quizforge.db

# Authentication Security (Minimum 32 characters for HS256 JWT signing)
JWT_SECRET=quizforge-super-secret-dev-jwt-key-replace-in-production-min-32-chars

# CORS (Frontend client origin)
CORS_ORIGIN=http://localhost:5173

# Rate Limiting & Threat Defense (Milestone 17)
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# Biometric WebAuthn / Passkeys Configuration (Milestone 19)
# RP ID must match the host domain (e.g. localhost or quizforge.dev)
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:5173

# Pluggable Multi-LLM Providers (Milestone 1, 5, 7, 12, 14, 15)
# Google Gemini API (Flash 2.5 + Vision)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Groq API (High-speed Llama 3.3 / GPT-OSS inference)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# NVIDIA NIM API (Enterprise Llama 3.3 / Nemotron inference)
NVIDIA_API_KEY=nvapi-your_nvidia_api_key_here
NVIDIA_MODEL=meta/llama-3.3-70b-instruct

# GitHub Personal Access Token (Optional - increases rate limit for code-quiz ingestion)
GITHUB_TOKEN=ghp_your_github_token_here
